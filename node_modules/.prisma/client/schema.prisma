// ============================================================
// PawSphere - Prisma Schema (MySQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum UserRole {
  user // Pemilik hewan / pengguna umum / relawan
  vet // Dokter hewan
  shelter // Pengelola shelter
  klinik // Pengelola klinik
  admin // Administrator
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum UrgencyLevel {
  green
  yellow
  red
}

enum ReservationStatus {
  pending // baru masuk, menunggu konfirmasi klinik
  confirmed // dikonfirmasi klinik / terjadwal
  completed
  cancelled
}

enum ClinicPaymentStatus {
  cash_due
  pending
  paid
  partially_refunded
  failed
  expired
  cancelled
  refunded
}

// ------------------------------------------------------------
// CORE: USER
// ------------------------------------------------------------

model User {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(150)
  phoneNumber String?  @map("phone_number") @db.VarChar(20)
  avatarUrl   String?  @map("avatar_url") @db.LongText
  password    String   @db.VarChar(255)
  role        UserRole @default(user)
  isActive    Boolean  @default(true) @map("is_active")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  aiTriageHistories  AiTriageHistory[]
  vetProfile         VetProfile?
  consultations      Consultation[]
  sentMessages       ConsultationMessage[]
  emergencyReports   EmergencyReport[]
  clinicReservations ClinicReservation[]
  managedClinics     Clinic[]              @relation("ClinicOwner")

  @@map("users")
}

// ------------------------------------------------------------
// AI CHAT DIAGNOSA
// ------------------------------------------------------------

model AiTriageHistory {
  id                  String       @id @default(uuid())
  userId              String       @map("user_id")
  animalType          String       @map("animal_type") @db.VarChar(50)
  age                 String       @db.VarChar(50)
  symptoms            Json
  duration            String       @db.VarChar(100)
  additionalCondition String?      @map("additional_condition") @db.Text
  urgencyLevel        UrgencyLevel @map("urgency_level")
  summary             String       @db.Text
  firstAidAdvice      Json         @map("first_aid_advice")
  recommendation      String       @db.Text
  source              String       @default("stub") @db.VarChar(20)
  disclaimer          String       @db.Text
  updatedAt           DateTime     @updatedAt @map("updated_at")
  createdAt           DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ai_triage_histories")
}

// ============================================================
// MODELS BELOW DEFINED FOR FUTURE ITERATIONS
// ============================================================

// ------------------------------------------------------------
// SHELTER
// ------------------------------------------------------------

model Shelter {
  id                 String             @id @default(uuid())
  ownerUserId        String?            @map("owner_user_id")
  name               String             @db.VarChar(150)
  description        String             @db.Text
  address            String             @db.VarChar(255)
  phoneNumber        String             @map("phone_number") @db.VarChar(20)
  capacity           Int                @default(0)
  latitude           Float?
  longitude          Float?
  operatingHours     String?            @map("operating_hours") @db.VarChar(50)
  isOpenNow          Boolean            @default(true) @map("is_open_now")
  verificationStatus VerificationStatus @default(pending) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  verifiedByAdminId  String?            @map("verified_by_admin_id")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  updatedAt          DateTime           @updatedAt @map("updated_at")
  createdAt          DateTime           @default(now()) @map("created_at")

  animals   Animal[]
  campaigns DonationCampaign[]

  @@index([ownerUserId])
  @@map("shelters")
}

// ------------------------------------------------------------
// ANIMAL / ADOPTION
// ------------------------------------------------------------

model Animal {
  id             String   @id @default(uuid())
  shelterId      String   @map("shelter_id")
  name           String   @db.VarChar(100)
  species        String   @db.VarChar(50)
  breed          String?  @db.VarChar(100)
  age            String?  @db.VarChar(50)
  gender         String?  @db.VarChar(20)
  description    String?  @db.Text
  imageUrl       String?  @map("image_url") @db.LongText
  isVaccinated   Boolean  @default(false) @map("is_vaccinated")
  isSterilized   Boolean  @default(false) @map("is_sterilized")
  adoptionStatus String   @default("available") @map("adoption_status") @db.VarChar(30)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  shelter      Shelter               @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  applications AdoptionApplication[]

  @@index([shelterId])
  @@map("animals")
}

model AdoptionApplication {
  id              String   @id @default(uuid())
  animalId        String   @map("animal_id")
  applicantUserId String   @map("applicant_user_id")
  fullName        String   @map("full_name") @db.VarChar(100)
  phoneNumber     String   @map("phone_number") @db.VarChar(20)
  email           String   @db.VarChar(150)
  address         String   @db.Text
  experience      String?  @db.Text
  reason          String?  @db.Text
  status          String   @default("submitted") @db.VarChar(30)
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@map("adoption_applications")
}

// ------------------------------------------------------------
// VET CONNECT
// ------------------------------------------------------------

model VetProfile {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  specialization  String?  @db.VarChar(150)
  sipNumber       String?  @map("sip_number") @db.VarChar(100)
  experienceYears Int      @default(0) @map("experience_years")
  consultationFee Int      @default(0) @map("consultation_fee")
  rating          Float    @default(0)
  isAvailable     Boolean  @default(true) @map("is_available")
  isVerified      Boolean  @default(false) @map("is_verified")
  location        String?  @db.VarChar(150)
  about           String?  @db.Text
  species         Json?
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  consultations Consultation[]

  @@map("vet_profiles")
}

model Consultation {
  id           String   @id @default(uuid())
  vetProfileId String   @map("vet_profile_id")
  userId       String   @map("user_id")
  method       String   @db.VarChar(20)
  status       String   @default("pending") @db.VarChar(30)
  notes        String?  @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  vetProfile    VetProfile            @relation(fields: [vetProfileId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prescriptions Prescription[]
  messages      ConsultationMessage[]

  @@index([vetProfileId])
  @@index([userId])
  @@map("consultations")
}

model ConsultationMessage {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  senderId       String   @map("sender_id")
  content        String   @db.Text
  type           String   @default("text") @db.VarChar(20) // text | image | audio
  attachmentUrl  String?  @map("attachment_url") @db.LongText // base64 data URL
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("consultation_messages")
}

model Prescription {
  id             String   @id @default(uuid())
  consultationId String   @map("consultation_id")
  notes          String   @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@index([consultationId])
  @@map("prescriptions")
}

// ------------------------------------------------------------
// MARKETPLACE / APOTEK
// ------------------------------------------------------------

model Product {
  id                   String   @id @default(uuid())
  name                 String   @db.VarChar(150)
  category             String   @db.VarChar(50)
  description          String?  @db.Text
  price                Int      @default(0)
  stock                Int      @default(0)
  imageUrl             String?  @map("image_url") @db.VarChar(255)
  requiresPrescription Boolean  @default(false) @map("requires_prescription")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  totalAmount     Int      @default(0) @map("total_amount")
  shippingAddress String?  @map("shipping_address") @db.Text
  paymentMethod   String?  @map("payment_method") @db.VarChar(50)
  status          String   @default("pending") @db.VarChar(30)
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  quantity  Int      @default(1)
  unitPrice Int      @map("unit_price")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ------------------------------------------------------------
// PAW ALERT
// ------------------------------------------------------------

model EmergencyReport {
  id             String   @id @default(uuid())
  reporterUserId String   @map("reporter_user_id")
  animalType     String   @map("animal_type") @db.VarChar(50)
  condition      String   @db.VarChar(100)
  description    String?  @db.Text
  photoUrl       String?  @map("photo_url") @db.LongText
  latitude       Float?
  longitude      Float?
  status         String   @default("open") @db.VarChar(30)
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  reporter User @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([reporterUserId])
  @@map("emergency_reports")
}

// ------------------------------------------------------------
// CARE FUNDING
// ------------------------------------------------------------

model DonationCampaign {
  id           String    @id @default(uuid())
  shelterId    String    @map("shelter_id")
  title        String    @db.VarChar(200)
  description  String    @db.Text
  imageUrl     String?   @map("image_url") @db.LongText
  targetAmount Int       @map("target_amount")
  raisedAmount Int       @default(0) @map("raised_amount")
  urgency      String    @default("normal") @db.VarChar(20)
  deadline     DateTime?
  status       String    @default("active") @db.VarChar(20)
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  shelter   Shelter    @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  donations Donation[]

  @@index([shelterId])
  @@map("donation_campaigns")
}

model Donation {
  id          String   @id @default(uuid())
  campaignId  String   @map("campaign_id")
  donorUserId String?  @map("donor_user_id")
  donorName   String?  @map("donor_name") @db.VarChar(100)
  type        String   @default("money") @db.VarChar(20)
  amount      Int      @default(0)
  message     String?  @db.Text
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign DonationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("donations")
}

// ------------------------------------------------------------
// GUEST AI USAGE
// ------------------------------------------------------------

model GuestAiUsage {
  id        String   @id @default(uuid())
  guestId   String   @map("guest_id") @db.VarChar(100)
  sessionId String   @map("session_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([guestId, sessionId])
  @@index([guestId, createdAt])
  @@map("guest_ai_usages")
}

// ------------------------------------------------------------
// CLINIC (Direktori klinik mitra + reservasi)
// ------------------------------------------------------------

model Clinic {
  id                   String   @id // slug, mis. "satwa-medika"
  ownerUserId          String?  @map("owner_user_id")
  number               Int      @default(0)
  name                 String   @db.VarChar(150)
  shortArea            String?  @map("short_area") @db.VarChar(100)
  area                 String   @db.VarChar(150)
  address              String?  @db.VarChar(255)
  distance             String?  @db.VarChar(30)
  distanceKm           Float?   @map("distance_km")
  isOpenNow            Boolean  @default(true) @map("is_open_now")
  openStatus           String?  @map("open_status") @db.VarChar(100)
  hours                String?  @db.VarChar(100)
  latitude             Float?
  longitude            Float?
  image                String?  @db.LongText
  images               Json?
  doctor               Json?
  hospitalizationBadge String?  @map("hospitalization_badge") @db.VarChar(100)
  hospitalizationFull  Boolean  @default(false) @map("hospitalization_full")
  boardingBadge        String?  @map("boarding_badge") @db.VarChar(100)
  startingPrice        String?  @map("starting_price") @db.VarChar(50)
  homeCarePrice        String?  @map("home_care_price") @db.VarChar(50)
  inpatientPrice       String?  @map("inpatient_price") @db.VarChar(50)
  boardingPrice        String?  @map("boarding_price") @db.VarChar(50)
  availableServices    Json?    @map("available_services")
  isVerified           Boolean  @default(true) @map("is_verified")
  updatedAt            DateTime @updatedAt @map("updated_at")
  createdAt            DateTime @default(now()) @map("created_at")

  owner        User?               @relation("ClinicOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reservations ClinicReservation[]

  @@index([ownerUserId])
  @@map("clinics")
}

model ClinicReservation {
  id                     String              @id @default(uuid())
  clinicId               String              @map("clinic_id")
  userId                 String              @map("user_id")
  serviceType            String              @map("service_type") @db.VarChar(30) // konsultasi | rawat_inap | penitipan
  careMethod             String              @map("care_method") @db.VarChar(20) // klinik | rumah
  petName                String              @map("pet_name") @db.VarChar(100)
  petType                String?             @map("pet_type") @db.VarChar(100)
  petAge                 String?             @map("pet_age") @db.VarChar(50)
  petWeight              String?             @map("pet_weight") @db.VarChar(50)
  doctorName             String?             @map("doctor_name") @db.VarChar(150)
  scheduleDate           String?             @map("schedule_date") @db.VarChar(100)
  scheduleTime           String?             @map("schedule_time") @db.VarChar(50)
  checkInDate            String?             @map("check_in_date") @db.VarChar(50)
  checkOutDate           String?             @map("check_out_date") @db.VarChar(50)
  complaint              String?             @db.Text
  notes                  String?             @db.Text
  address                String?             @db.Text
  phone                  String?             @db.VarChar(30)
  estimatedTotal         Int                 @default(0) @map("estimated_total")
  status                 ReservationStatus   @default(pending)
  bookingCode            String              @unique @map("booking_code") @db.VarChar(50)
  queueNumber            String?             @map("queue_number") @db.VarChar(20)
  paymentMethod          String              @default("cash") @map("payment_method") @db.VarChar(20)
  paymentStatus          ClinicPaymentStatus @default(cash_due) @map("payment_status")
  idempotencyKey         String?             @unique @map("idempotency_key") @db.VarChar(100)
  idempotencyFingerprint String?             @map("idempotency_fingerprint") @db.Char(64)
  midtransOrderId        String?             @unique @map("midtrans_order_id") @db.VarChar(50)
  midtransTransactionId  String?             @unique @map("midtrans_transaction_id") @db.VarChar(100)
  snapToken              String?             @map("snap_token") @db.VarChar(255)
  snapRedirectUrl        String?             @map("snap_redirect_url") @db.Text
  paymentProviderStatus  String?             @map("payment_provider_status") @db.VarChar(50)
  paidAt                 DateTime?           @map("paid_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  createdAt              DateTime            @default(now()) @map("created_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([userId])
  @@index([paymentStatus])
  @@map("clinic_reservations")
}
